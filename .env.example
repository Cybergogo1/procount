# Copy to .env and fill in. EXPO_PUBLIC_* vars are inlined into the client
# bundle at build time (so only put publishable keys here, never secrets).

# Supabase (Project Settings -> API)
EXPO_PUBLIC_SUPABASE_URL=https://vndlqswuanywconfxgey.supabase.co
