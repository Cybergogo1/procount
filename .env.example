# RevenueCat public SDK keys (one per platform)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=

# Set to true to bypass the trial/paywall gate (demo & test builds, until
# RevenueCat is configured). Leave blank/false for real subscription behaviour.
EXPO_PUBLIC_DISABLE_PAYWALL=

